# Panel admin: folder ini berdiri sendiri. Di hosting, arahkan domain/subdomain admin langsung ke folder ini.
#   /              → index.php (dasbor)
#   /kamar         → kamar/index.php
#   /kamar/form    → kamar/form.php

Options -Indexes -MultiViews
DirectoryIndex index.php
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On


    # Potongan kode & file tersembunyi tidak pernah disajikan.
    RewriteRule (^|/)\. - [R=404,L]
    RewriteRule ^includes(/|$) - [R=404,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^$ index.php [QSA,L]

    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.+?)/?$ $1/index.php [QSA,L]

    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [QSA,L]

    RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
